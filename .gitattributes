# Force LF line endings for text files deployed to Linux servers
* text=auto eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
